# Liara production environment template
# Set these in Liara Environment Variables, not in Git.

SECRET_KEY=<generate-a-long-random-secret>
TOTP_ENCRYPTION_KEY=<generate-a-fernet-key>

DATABASE_URL=sqlite:////app/db/app.db
AUTO_CREATE_DB=true
RUN_SCHEDULER=true

MARKET_HISTORY_ENABLED=true
MARKET_HISTORY_RETENTION_DAYS=30
MARKET_HISTORY_MAX_ROWS_PER_SCAN=250
SCAN_INTERVAL_MINUTES=5
PRICES_INTERVAL_SECONDS=60

# Global market data
CRYPTOSSCANNER_CMC_KEY=<your-cmc-key>

# Safe default: paper trading
LIVE_TRADING_ENABLED=false
LIVE_TRADING_TESTNET=false
LIVE_TRADING_REQUIRE_EXPLICIT_CONFIRMATION=true

# Leave empty while using paper mode.
# Only populate after deliberately enabling live trading.
NOBITEX_API_KEY=
NOBITEX_PRIVATE_KEY=

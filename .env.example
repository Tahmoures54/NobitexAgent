# ══════════════════════════════════════════════════════════════
# CryptoScanner Web — ENVIRONMENT TEMPLATE
#
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env          (Linux / macOS)
#   copy .env.example .env        (Windows)
#
# NEVER commit `.env` to git.
# ══════════════════════════════════════════════════════════════

# ── App ─────────────────────────────────────────────────────
APP_NAME=CryptoScanner Web
APP_VERSION=0.1.0
DEBUG=false

# ── Security ────────────────────────────────────────────────
# MUST be a long random string in production.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=please-generate-a-64-char-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Database ────────────────────────────────────────────────
# MVP default (SQLite, easy to start):
DATABASE_URL=sqlite:///./data/app.db

# Postgres example (production):
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/cryptoscanner

# ── Scanner ─────────────────────────────────────────────────
SCAN_INTERVAL_MINUTES=5
SCAN_LIMIT=250

# ── Prices watcher (Paper SL/TP auto-close) ────────────────
PRICES_INTERVAL_SECONDS=60

# ── Admin ───────────────────────────────────────────────────
ADMIN_EMAIL=admin@example.com

# ── CORS ────────────────────────────────────────────────────
# Leave empty when the frontend is served by the same FastAPI app.
# If hosting the frontend separately, list exact origins as JSON:
# CORS_ORIGINS=["https://yourdomain.com","https://www.yourdomain.com"]
CORS_ORIGINS=[]

# ── External market data (optional) ────────────────────────
# If empty, the app uses CoinGecko's free tier.
CRYPTOSSCANNER_CMC_KEY=

# External identity authentication
# Google OAuth 2.0 Web Client ID from Google Cloud Console.
GOOGLE_CLIENT_ID=
# Microsoft Entra App Registration client ID.
MICROSOFT_CLIENT_ID=
MICROSOFT_AUTHORITY=https://login.microsoftonline.com/common/v2.0
MICROSOFT_JWKS_URL=https://login.microsoftonline.com/common/discovery/v2.0/keys
